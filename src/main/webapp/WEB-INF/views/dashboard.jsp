<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AV Fleet Dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><aside><h2>AV<span>FLEET</span></h2><p>WORKSPACE</p><b>▦ &nbsp; Overview</b><p>◈ &nbsp; Vehicles</p><p>⌁ &nbsp; Routes</p><p>⚙ &nbsp; Maintenance</p><p>♧ &nbsp; Alerts</p><footer>Fleet Manager<br><small>Demo workspace</small></footer></aside><main><header><div><small>FLEET OPERATIONS / OVERVIEW</small><h1>Fleet dashboard</h1><p>Monitor vehicle health and operational status.</p></div><label>● System online</label></header><section class="stats"><article>Total vehicles<strong>5</strong><small>Registered in fleet</small></article><article>Active vehicles<strong class="green">2</strong><small>Currently operational</small></article><article>Low battery<strong class="amber">1</strong><small>Requires attention</small></article><article>Maintenance<strong class="red">1</strong><small>Service required</small></article></section><section class="panel"><h3>Vehicle status</h3><p>Latest vehicle records · <c:out value="${source}"/></p><div class="scroll"><table><tr><th>VEHICLE</th><th>STATUS</th><th>BATTERY</th><th>HEALTH</th><th>LOCATION</th></tr><c:forEach var="v" items="${vehicles}"><tr><td><b><c:out value="${v.code}"/></b></td><td><span class="tag"><c:out value="${v.status}"/></span></td><td><c:out value="${v.battery}"/>%</td><td><c:out value="${v.health}"/></td><td><c:out value="${v.location}"/></td></tr></c:forEach></table></div></section><small class="note">Student prototype · Simulated vehicle data; no real vehicle is controlled.</small></main></body></html>